rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active != false;
    }
    match /{contentCollection}/{documentId} {
      allow read: if contentCollection in ['developers', 'materials', 'questions', 'examples', 'settings'];
      allow create, update, delete: if isTeacher()
        && contentCollection in ['developers', 'materials', 'questions', 'examples', 'settings'];
    }
    match /teachers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /results/{documentId} {
      allow read, write: if isTeacher();
    }
  }
}
